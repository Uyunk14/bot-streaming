Options -Indexes
DirectoryIndex index.php index.html

# Lindungi file konfigurasi & catatan
<FilesMatch "^(config\.php|.*\.log|.*\.lock|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Mini App: jangan cache index.html terlalu lama supaya pembaruan cepat terlihat
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
