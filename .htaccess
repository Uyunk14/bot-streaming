Options -Indexes
DirectoryIndex index.php index.html

# Lindungi file konfigurasi & catatan
<FilesMatch "^(config\.php|.*\.log|.*\.lock|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Kompresi gzip: data beranda (JSON) & file JS/CSS jadi ±5x lebih kecil
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/vtt application/javascript text/javascript application/json application/dash+xml
</IfModule>

<IfModule mod_headers.c>
  # Halaman HTML (index, drmtest) selalu dicek ulang supaya pembaruan cepat terlihat
  <FilesMatch ".html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # app.js / app.css diberi versi (?v=) di index.html -> boleh disimpan lama di HP
  <FilesMatch "\.(js|css|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
